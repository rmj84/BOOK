# Copy this file to .env and fill in real values. .env is gitignored.

# Hosted Postgres connection string (e.g. from Neon: neon.tech).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Naver Book Search API (developers.naver.com) ---
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# --- Aladin OpenAPI (aladin.co.kr) — primary book search provider ---
ALADIN_TTB_KEY=""

# Which provider /api/books/search uses: "aladin" | "naver" | "manual"
BOOK_SEARCH_PROVIDER="aladin"
