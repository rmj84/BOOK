# Copy this file to .env and fill in real values. .env is gitignored.

# Hosted Postgres, split into pooled (app runtime) and direct (migrations)
# connection strings — required when the DB sits behind PgBouncer (e.g. Neon's
# "-pooler" host). Without this split, concurrent traffic on a serverless
# platform (Vercel) can exhaust direct DB connections and writes start failing.
# Neon dashboard > Connection Details > toggle "Pooled connection" for DATABASE_URL,
# untoggled for DIRECT_URL.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Naver Book Search API (developers.naver.com) ---
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# --- Aladin OpenAPI (aladin.co.kr) — primary book search provider ---
ALADIN_TTB_KEY=""

# Which provider /api/books/search uses: "aladin" | "naver" | "manual"
BOOK_SEARCH_PROVIDER="aladin"

# --- Support / donation ---
# 카카오페이 송금 링크 (qr.kakaopay.com/...). 비워두면 후원 버튼이 안 보임.
NEXT_PUBLIC_SUPPORT_URL=""
